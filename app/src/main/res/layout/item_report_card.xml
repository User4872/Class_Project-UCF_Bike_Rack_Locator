<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_report_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvReportDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="09-16-2026   1:20 PM"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvReportLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Report: ENG1 Rack Status"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvReportOccupancy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Occupancy: Low"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="italic" />
</LinearLayout>